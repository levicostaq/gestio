PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=gestio

# Segredo usado para assinar o token de login (JWT).
# Troque por uma frase longa e aleatória no seu .env. Nunca suba o valor real para o GitHub.
JWT_SECRET=troque_por_um_segredo_longo
JWT_EXPIRES_IN=8h

# Só para banco na nuvem (TiDB). No PC deixe como está.
# DB_SSL=true      conexão criptografada, obrigatória no TiDB
# DB_POOL=3        menos conexões por instância na Vercel
# DB_TIMEZONE=-03:00
