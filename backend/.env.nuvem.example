# Copie para .env.nuvem e preencha com os dados do TiDB (botão "Connect" do cluster).
# Usado só para criar o banco: node --env-file=.env.nuvem scripts/criar-banco.js
# Nunca suba o .env.nuvem para o GitHub.
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=senha_gerada_no_tidb
DB_SSL=true
